NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
APP_BASE_PATH=/backend
# Optional override; defaults to ${APP_BASE_PATH}/socket.io in production
# SOCKET_PATH=/backend/socket.io

# cPanel production: use localhost when this PHP backend is hosted in the same cPanel account/server as MySQL.
# Local laptop access to cPanel MySQL usually requires cPanel > Remote MySQL to whitelist your public IP.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_database
DB_USER=cpaneluser_dbuser
DB_PASSWORD=replace-with-cpanel-db-user-password
DB_CONNECT_TIMEOUT=5

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=12h

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@silvershield.org
SMTP_FROM_NAME=Silver Shield Organisation

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_PAYBILL=522522
MPESA_ACCOUNT_NUMBER=1342183193
MPESA_CALLBACK_URL=https://api.your-domain.com/api/donations/mpesa/callback
MPESA_ENVIRONMENT=production
MPESA_ACCOUNT_REFERENCE=SilverShield

STK_PROVIDER=PAYHERO
PAYMENT_LINK=https://lipwa.link/4852
PAYMENT_PROMPT_DESCRIPTION=silvershield organization
PAYHERO_ENVIRONMENT=production
PAYHERO_CALLBACK_URL=https://your-domain.com/backend/api/donations/payhero/callback
PAYHERO_ACCOUNT_NUMBER=4852
PAYHERO_CHANNEL_ID=
PAYHERO_AUTH=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=live
PAYPAL_RETURN_URL=https://your-domain.com/donate
PAYPAL_CANCEL_URL=https://your-domain.com/donate

ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-strong-admin-password
